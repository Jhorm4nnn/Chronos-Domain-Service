    {
      "name": "1 · Casos del taller (tabla 2)",
      "item": [
        {
          "name": "1 · FELIZ · HU-9 Crear turno (201)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{domain_url}}/api/turnos",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{cliente_id}},\n  \"profesionalId\": {{profesional_id}},\n  \"fecha\": \"{{lunes}}\",\n  \"hora\": \"09:00\",\n  \"duracionMinutos\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// próximo lunes: el profesional de prueba atiende los lunes de 08:00 a 12:00",
                  "const d = new Date();",
                  "d.setDate(d.getDate() + (((8 - d.getDay()) % 7) || 7));",
                  "const p = n => String(n).padStart(2, '0');",
                  "pm.environment.set('lunes', `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('turno_id', pm.response.json().id);",
                  "pm.test('Queda AGENDADO', () => pm.expect(pm.response.json().estado).to.eql('AGENDADO'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2 · FELIZ · HU-12 Consultar turnos (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{domain_url}}/api/turnos?profesionalId={{profesional_id}}&desde={{lunes}}&hasta={{lunes}}",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
