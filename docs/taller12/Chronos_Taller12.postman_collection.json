          "name": "4 · NEGATIVO · HU-11 Borrar un turno con DELETE (contrato 405, hoy 500)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{domain_url}}/api/turnos/{{turno_id}}",
            "description": "La prueba FALLA a propósito mientras exista la discrepancia D1: el contrato dice 405 y el servicio responde 500.",
