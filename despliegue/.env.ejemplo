# Plantilla de despliegue/.env. NO ponga valores reales en este archivo.
# En el servidor, ./generar-env.sh crea el .env real con valores aleatorios.

# Secreto compartido AuthCore <-> Domain Service, en Base64, mínimo 48 bytes (HS384): openssl rand -base64 48
JWT_SECRET_BASE64=

# Contraseñas de MySQL (root y un usuario por servicio)
MYSQL_ROOT_PASSWORD=
AUTHCORE_DB_PASSWORD=
TURNOS_DB_PASSWORD=

# Administrador inicial de AuthCore (mínimo 8 caracteres, con letras y números)
ADMIN_USERNAME=
ADMIN_PASSWORD=
